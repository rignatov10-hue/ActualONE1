# Model: pick one provider and its key
#
# ANALYST_PROVIDER: mistral (default) | openai | anthropic | openai-compatible
# ANALYST_MODEL: model name at that provider (optional, sensible defaults exist)
# ANALYST_LLM_BASE_URL: endpoint for openai-compatible servers (KoboldCpp, OpenRouter,
#   DeepSeek, vLLM...), or an endpoint override for mistral/openai/anthropic
#
MISTRAL_API_KEY=

# --- Mistral Cloud (default; also required for the Google Drive connector) ---
# MISTRAL_API_KEY=mstrl_...
# ANALYST_PROVIDER=mistral
# ANALYST_MODEL=mistral-medium-latest

# --- Local model via KoboldCpp / llama.cpp / LM Studio (http://127.0.0.1:5001/v1) ---
# MISTRAL_API_KEY=mstrl_...
# ANALYST_PROVIDER=openai-compatible
# ANALYST_MODEL=my-local-model
# ANALYST_LLM_BASE_URL=http://127.0.0.1:5001/v1
# OPENAI_API_KEY=local

# --- OpenAI ---
# OPENAI_API_KEY=sk-...
# ANALYST_PROVIDER=openai
# ANALYST_MODEL=gpt-4.1

# --- Anthropic ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANALYST_PROVIDER=anthropic
# ANALYST_MODEL=claude-sonnet-4-5

# --- OpenRouter (or DeepSeek, vLLM, ... any OpenAI-compatible service) ---
# OPENAI_API_KEY=sk-or-...   (or the service's own key)
# ANALYST_PROVIDER=openai-compatible
# ANALYST_MODEL=openai/gpt-4.1
# ANALYST_LLM_BASE_URL=https://openrouter.ai/api/v1
